{
  "name": "@colin_kerr/query-agent-react",
  "version": "0.1.1",
  "description": "The query agent's React controls: the chat (AgentChat), the larger control (AgentWorkbench), and the feedback form.",
  "keywords": [
    "itwin",
    "itwinjs",
    "imodel",
    "react",
    "ecsql",
    "ai",
    "agent",
    "chat"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css"
  },
  "dependencies": {
    "@colin_kerr/query-agent-client": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "author": "Colin Kerr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColinKerr/query_agent_ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ColinKerr/query_agent_ui#readme",
  "bugs": {
    "url": "https://github.com/ColinKerr/query_agent_ui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
